# This repository holds the framework only — the reader, the parsers, the
# build.  It never holds the material being read.
#
# `sandbox/` is read-only copies of the PQCPlus papers and Lean sources, and
# `stignore-build/` is what is compiled from them.  Both are research content
# belonging to assets/1-projects/PQCPlus.  Populate them with `make sync`.
# `interproof.toml` here is the configuration for that case study, and so is a
# fact about one machine's layout rather than about the framework.

/sandbox/
/stignore-build/
/interproof.toml
.interproof/

# Generated: `interproof build` reproduces the whole folder in ~20 s.  It is
# the deliverable, but it is several megabytes rewritten wholesale on every
# build, so history is better off without a copy per commit.

/site/

# LaTeX droppings, should a build ever run in place rather than in -outdir
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz

__pycache__/
*.egg-info/
/build/
/dist/

# browser-automation leftovers from interactive debugging
/.playwright-mcp/
